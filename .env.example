# Stillpoint — Environment Variable Configuration
#
# Copy this file to `.env` and fill in your values.
# All variables are optional — Stillpoint works out of the box with the
# defaults when you run `scripts/setup.sh`.
#
# ---------------------------------------------------------------------------
# LLM API Keys (required for the chat interface to work)
# ---------------------------------------------------------------------------
# Pick at least one provider and set its key.

# ANTHROPIC_API_KEY=your-key-here
# OPENAI_API_KEY=your-key-here
# OPENROUTER_API_KEY=your-key-here
# GOOGLE_API_KEY=your-key-here

# ---------------------------------------------------------------------------
# Path Overrides (optional — for non-standard installations)
# ---------------------------------------------------------------------------

# STILLPOINT_PALACE_PATH=/custom/path/to/palace
#   Override where ChromaDB stores its data.
#   Default: <project_root>/data/palace

# STILLPOINT_MEMPALACE_BIN=/opt/homebrew/bin/mempalace
#   Override path to the MemPalace CLI binary.
#   Default: searches PATH, then the active venv's bin directory.

# STILLPOINT_NOTEBOOKLM_BIN=/Users/you/.local/bin/notebooklm
#   Override path to the NotebookLM CLI binary.
#   Default: searches PATH.

# ---------------------------------------------------------------------------
# Optional: Local Podcast TTS (only needed for --method local)
# ---------------------------------------------------------------------------

# ALEXANDRIA_URL=http://127.0.0.1:4200
#   URL of a local Alexandria/Qwen3-TTS server for podcast generation.
#   Only used if you run `scripts/generate_podcast.py --method local` and
#   have podcastfy configured to use Alexandria.

# ---------------------------------------------------------------------------
# Optional: Static Knowledge Base (fallback when NotebookLM is unavailable)
# ---------------------------------------------------------------------------

# STILLPOINT_STATIC_KB=true
#   When true (default), query_knowledge() falls back to the static
#   knowledge base in data/knowledge/ if NotebookLM is unreachable or no
#   notebooks are configured. Set to false to disable the fallback and
#   return [UNGROUNDED] as before.
#   Recognized falsy values: false, 0, no, off (case-insensitive).
